  {"do": "lewis_gate_pair", "bh3": -3, "bf3": -2, "co": -1, "tag": "the-gate", "artifact": "benchmarks/lewis_gate/artifacts/pair.json", "after_ms": 1500},
  {"do": "shot", "path": "benchmarks/lewis_gate/artifacts/gate_window.png", "widget": "lewis_pairing", "after_ms": 500},
