[
  {"do": "smiles", "smiles": "C[O-]", "name": "Methoxide", "after_ms": 2500},
  {"do": "select", "molecule": -1, "after_ms": 2500},
  {"do": "conformers", "count": 3, "after_ms": 15000},
  {"do": "qc_run", "calc_type": "Geometry Optimization", "method": "B3LYP 6-31G*", "after_ms": 1000},
  {"do": "qc_wait", "timeout_ms": 900000},
  {"do": "conformer_report", "tag": "optimized-geometry-is-the-canonical-one",
   "expect": {"canonical_method": "orca_opt", "canonical_mapped": true}},

  {"do": "dialog", "name": "SettingsDialog", "section": "quantum_chemistry", "after_ms": 1200},
  {"do": "shot", "path": "C:/Users/pmpd/AppData/Local/Temp/claude/D--Random-Projects-OpenChem-Studio--claude-worktrees-calculator-result-selection-ff3f27/2ab0c6fd-b193-4829-a196-282f567a03a2/scratchpad/settings_quantum_chemistry.png", "widget": "dialog"},
  {"do": "control", "name": "fukuiAnionFPlus", "value": false, "after_ms": 800},
  {"do": "close_dialog", "after_ms": 800},
  {"do": "qc_run", "calc_type": "Fukui functions (Hirshfeld)", "method": "B3LYP 6-31G*", "after_ms": 1000},
  {"do": "qc_wait", "timeout_ms": 900000},
  {"do": "qc_panel_report", "tag": "switched-off-through-the-real-checkbox-f-minus-alone",
   "expect": {
     "calc_type": "Fukui functions (Hirshfeld)",
     "run_calc_type": "fukui", "run_status": "completed", "per_atom_outputs": 1,
     "results_contains": [
       "Largest f- (attack by an electrophile): O (atom 2)",
       "f+, f0 and the dual descriptor were not computed",
       "This run left the dianion out; Settings > Quantum chemistry can switch it on."
     ],
     "results_excludes": ["The dianion is"]}},

  {"do": "dialog", "name": "SettingsDialog", "section": "quantum_chemistry", "after_ms": 1200},
  {"do": "control", "name": "fukuiAnionFPlus", "value": true, "after_ms": 800},
  {"do": "close_dialog", "after_ms": 800},
  {"do": "qc_run", "calc_type": "Fukui functions (Hirshfeld)", "method": "B3LYP 6-31G*", "after_ms": 1000},
  {"do": "qc_wait", "timeout_ms": 900000},
  {"do": "qc_panel_report", "tag": "switched-back-on-through-the-real-checkbox-all-four",
   "expect": {
     "calc_type": "Fukui functions (Hirshfeld)",
     "run_calc_type": "fukui", "run_status": "completed", "per_atom_outputs": 4,
     "results_contains": [
       "Largest f+ (attack by a nucleophile)",
       "Largest f- (attack by an electrophile): O (atom 2)",
       "The dianion is",
       "ABOVE the anion"
     ],
     "results_excludes": ["f+, f0 and the dual descriptor were not computed"]}},
  {"do": "expect_clean"},
  {"do": "quit"}
]
