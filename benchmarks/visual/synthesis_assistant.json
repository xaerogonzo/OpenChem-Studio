[
  {"do": "synthesis_setup", "python": "", "config": ""},
  {"do": "smiles", "smiles": "CC(=O)Oc1ccccc1C(=O)O", "name": "Aspirin", "after_ms": 1500},
  {"do": "select", "molecule": -1, "after_ms": 1500},

  {"do": "ai_send", "text": "Find synthesis routes for this molecule.", "after_ms": 6000,
