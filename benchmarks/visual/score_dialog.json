[
  {"do": "smiles", "smiles": "CC(=O)Oc1ccccc1C(=O)O", "name": "Aspirin", "after_ms": 1500},
  {"do": "select", "molecule": -1, "after_ms": 6000},

  {"do": "score_dialog", "new": true, "tag": "an-empty-form-asks-and-cannot-be-saved", "after_ms": 500,
   "expect": {"ok": false, "save_enabled": false, "delete_enabled": false, "stored": 0, "scores": [], "n_inputs": 0,
              "message_contains": ["Give the score a name"], "shown_as_contains": ["(no name yet) (user-defined, unvalidated)"]}},

  {"do": "score_dialog", "tag": "typed-and-checked-but-nothing-stored-yet", "after_ms": 800,
   "fill": {"label": "Polar window", "inputs": [["psa", "descriptor:tpsa"]], "formula": "ramp(psa, 140, 60)"},
   "expect": {"ok": true, "works_out": "1", "save_enabled": true, "stored": 0, "n_inputs": 1, "marked": [],
              "preview_contains": ["For Aspirin: 0.955"], "message_contains": ["The formula checks", "works out to 1"],
              "shown_as_contains": ["Polar window (user-defined, unvalidated)"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_checks.png", "widget": "scores", "after_ms": 500},

  {"do": "score_dialog", "press": "save", "tag": "save-makes-it-and-it-reaches-results", "after_ms": 1200,
   "expect": {"stored": 1, "scores": ["Polar window (user-defined, unvalidated)"], "current": "Polar window (user-defined, unvalidated)",
              "dirty": false, "save_enabled": false, "delete_enabled": true, "project_unsaved": true,
              "results_listed": ["Polar window (user-defined, unvalidated)"]}},

  {"do": "score_dialog", "tag": "a-syntax-error-marks-the-formula-and-points-at-it", "after_ms": 500,
   "fill": {"formula": "ramp(psa, 140, 60) *"},
   "expect": {"ok": false, "where": "formula", "marked": ["formula"], "pointer_column": 20, "save_enabled": false, "revert_enabled": true,
              "dirty": true, "stored": 1, "message_contains": ["Formula:"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_syntax.png", "widget": "scores", "after_ms": 500},
  {"do": "score_dialog", "press": "revert", "tag": "revert-puts-the-saved-score-back", "after_ms": 500,
   "expect": {"ok": true, "dirty": false, "marked": [], "revert_enabled": false}},

  {"do": "score_dialog", "tag": "adding-an-area-to-a-number-is-a-unit-clash-in-the-formula", "after_ms": 500,
   "fill": {"inputs": [["psa", "descriptor:tpsa"], ["logp", "descriptor:mol_logp"]], "formula": "psa + logp"},
   "expect": {"ok": false, "where": "formula", "marked": ["formula"], "save_enabled": false, "stored": 1}},
  {"do": "score_dialog", "tag": "a-threshold-in-the-wrong-unit-is-refused-naming-both-units", "after_ms": 500,
   "fill": {"inputs": [["psa", "descriptor:tpsa"]], "constants": [{"name": "hi", "value": "140", "unit": "nm^2"}], "formula": "ramp(psa, hi, 60)"},
   "expect": {"ok": false, "where": "formula", "marked": ["formula"], "message_contains": ["nm^2", "Å^2"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_unit_clash.png", "widget": "scores", "after_ms": 500},
  {"do": "score_dialog", "tag": "the-same-threshold-in-the-right-unit-checks", "after_ms": 500,
   "fill": {"constants": [{"name": "hi", "value": "140", "unit": "Å^2"}]},
   "expect": {"ok": true, "marked": [], "n_constants": 1, "preview_contains": ["For Aspirin: 0.955"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_constant.png", "widget": "scores", "after_ms": 500},
  {"do": "score_dialog", "tag": "a-constant-typed-half-way-marks-the-constants", "after_ms": 500,
   "fill": {"constants": [{"name": "hi", "value": "14.", "unit": "Å^2"}]},
   "expect": {"ok": false, "where": "constants", "marked": ["constants"], "message_contains": ["Constants:"]}},
  {"do": "score_dialog", "tag": "two-estimates-of-one-quantity-mark-the-inputs", "after_ms": 500,
   "fill": {"inputs": [["a", "descriptor:esol_logs"], ["b", "calculator:solubility:Predicted intrinsic solubility (mol/L)"]],
            "constants": [], "formula": "a + b"},
   "expect": {"ok": false, "where": "inputs", "marked": ["inputs"], "message_contains": ["consensus predictor"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_consensus.png", "widget": "scores", "after_ms": 500},
  {"do": "score_dialog", "tag": "a-name-like-a-calculators-is-refused-on-the-name", "after_ms": 500,
   "fill": {"label": "CNS MPO again", "inputs": [["psa", "descriptor:tpsa"]], "formula": "ramp(psa, 140, 60)"},
   "expect": {"ok": false, "where": "label", "marked": ["label"], "message_contains": ["too close to"]}},

  {"do": "score_dialog", "press": "new", "confirm": "no", "tag": "leaving-a-changed-form-asks-and-no-stays", "after_ms": 500,
   "expect": {"asked": ["Unsaved changes"], "current": "Polar window (user-defined, unvalidated)", "dirty": true}},
  {"do": "score_dialog", "press": "new", "confirm": "yes", "tag": "yes-discards-and-starts-a-blank-score", "after_ms": 500,
   "expect": {"asked": ["Unsaved changes"], "current": null, "n_inputs": 0, "stored": 1}},

  {"do": "score_dialog", "tag": "a-second-score-with-a-named-constant", "after_ms": 800,
   "fill": {"label": "Blend with a constant", "inputs": [["psa", "descriptor:tpsa"], ["logp", "descriptor:mol_logp"]],
            "constants": [{"name": "hi", "value": "140", "unit": "Å^2"}], "formula": "ramp(psa, hi, 60) * ramp(logp, 5, 2)",
            "owner": "Alex", "note": "drawn from the default window"},
   "press": "save",
   "expect": {"stored": 2, "ok": true, "dirty": false, "n_constants": 1,
              "scores": ["Polar window (user-defined, unvalidated)", "Blend with a constant (user-defined, unvalidated)"],
              "results_listed": ["Polar window (user-defined, unvalidated)", "Blend with a constant (user-defined, unvalidated)"]}},

  {"do": "score_dialog", "new": true, "tag": "an-input-nothing-has-calculated-says-which-and-can-still-be-saved", "after_ms": 800,
   "fill": {"label": "Needs a calculator", "inputs": [["ob", "calculator:oxygen_balance:Oxygen balance (CO basis)"]], "result_unit": "%",
            "formula": "ob"},
   "press": "save",
   "expect": {"stored": 3, "ok": true,
              "preview_contains": ["For Aspirin: no value.", "ob (calculator:oxygen_balance:Oxygen balance (CO basis))", "has not been calculated for this molecule"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_no_value.png", "widget": "scores", "after_ms": 500},
  {"do": "calculator", "id": "oxygen_balance", "reveal": false, "after_ms": 4000},
  {"do": "score_dialog", "tag": "the-calculator-ran-and-the-open-window-has-its-number", "after_ms": 500,
   "expect": {"preview_contains": ["For Aspirin: -79.93 %"]}},
  {"do": "shot", "path": "artifacts/visual/score_dialog_value.png", "widget": "scores", "after_ms": 500},

  {"do": "score_dialog", "choose": "Polar window", "press": "delete", "confirm": "yes", "tag": "delete-asks-and-removes-only-the-definition", "after_ms": 800,
   "expect": {"asked": ["Delete score"], "stored": 2, "current": null,
              "scores": ["Blend with a constant (user-defined, unvalidated)", "Needs a calculator (user-defined, unvalidated)"]}},

  {"do": "expect_clean"},
  {"do": "quit"}
]
