[
  {"do": "smiles", "smiles": "O", "name": "Water", "after_ms": 1500},
  {"do": "select", "molecule": -1, "after_ms": 3000},
  {"do": "conformers", "count": 1, "after_ms": 8000},
  {"do": "conformer_report", "tag": "a-conformer-to-run-on", "expect": {"conformers": 1}},
  {"do": "panel", "id": "Quantum_Chemistry", "after_ms": 1000},

  {"do": "ai_send", "text": "Where would an electron go on this molecule, if it were open shell?",
   "script": [
     {"tool": "run_calculator", "input": {"calculator_id": "orca.fukui", "parameters": {"multiplicity": 2}}},
     {"text": "Fukui functions need a closed-shell species."}
   ], "after_ms": 3000},
  {"do": "ai_expect", "tag": "an-open-shell-request-is-refused-before-any-card-exists",
   "expect": {"pending": 0, "service_previews": 0, "notes": 0,
              "tool_results_contain": ["closed-shell species (multiplicity 1)", "\"ok\": false"]}},

  {"do": "ai_send", "text": "Where does an added or removed electron go on this molecule?",
   "script": [
     {"tool": "run_calculator", "input": {"calculator_id": "orca.fukui", "parameters": {"method_basis": "B3LYP def2-SVP"}}},
     {"text": "It is waiting for your approval."}
   ], "after_ms": 3000},
  {"do": "ai_expect", "tag": "asking-leaves-a-card-and-starts-nothing",
   "expect": {"pending": 1, "service_previews": 0, "notes": 0,
              "tool_results_contain": ["\"state\": \"awaiting_approval\"", "\"started\": false"],
              "ledger_contains": ["waiting for your approval"], "send_enabled": true}},
  {"do": "qc_panel_report", "tag": "the-panel-has-no-job-yet", "expect": {"status_contains": []}},
  {"do": "shot", "path": "benchmarks/visual/artifacts/ai_fukui_card.png", "after_ms": 500},

  {"do": "ai_card", "action": "approve", "after_ms": 1000},
  {"do": "ai_expect", "tag": "approving-starts-it-and-the-model-is-not-told-yet",
   "expect": {"pending": 0, "notes": 0, "ledger_contains": ["running in the Quantum Chemistry panel"]}},
  {"do": "qc_wait", "timeout_ms": 900000, "after_ms": 2000},
  {"do": "qc_panel_report", "tag": "the-panel-ran-it-as-its-own",
   "expect": {"run_calc_type": "fukui", "run_status": "completed", "per_atom_outputs": 4,
              "results_contains": ["Fukui functions (Hirshfeld, vertical) for 3 atoms:", "Not validated"]}},
  {"do": "ai_expect", "tag": "when-it-ends-the-ledger-and-the-note-say-so",
   "expect": {"notes": 1, "ledger_contains": ["ORCA finished it"],
              "notes_contain": ["The ORCA job you asked for, orca.fukui on Water", "ended 'completed'", "read_quantum_runs"]}},

  {"do": "expect_clean"},
  {"do": "quit"}
]
