[
  {"do": "smiles", "smiles": "c1ccccc1", "name": "Benzene", "after_ms": 2500},
  {"do": "select", "molecule": "Benzene", "after_ms": 2500},
  {"do": "report", "tag": "occupied-canvas"},

  {"do": "template_library", "category": "Rings", "entry": "Pyridine", "press": "insert",
   "tag": "insert-pyridine-beside-benzene", "after_ms": 1500,
   "expect": {"inserted": true, "smiles_contains": ".", "undo_delta": 1, "status": "Inserted."}},
  {"do": "shot", "path": "artifacts/visual/template_library_insert.png", "widget": "template_library", "after_ms": 400},

  {"do": "menu", "text": "Undo", "prefix": true, "in": "Edit", "after_ms": 1500},
  {"do": "template_library", "tag": "undo-restores-benzene", "after_ms": 3500,
   "expect": {"smiles_equals": "c1ccccc1", "redo_enabled": true}},

  {"do": "menu", "text": "Redo", "prefix": true, "in": "Edit", "after_ms": 1500},
  {"do": "template_library", "tag": "redo-restores-insert", "after_ms": 400,
   "expect": {"smiles_contains": ".", "redo_enabled": false}},

  {"do": "menu", "text": "Undo", "prefix": true, "in": "Edit", "after_ms": 1500},
  {"do": "template_library", "press": "save", "name": "Drive benzene",
   "tag": "save-my-templates", "after_ms": 800,
   "expect": {"my_templates_contains": "Drive benzene", "smiles_equals": "c1ccccc1"}},
  {"do": "template_library", "search": "Drive benzene", "press": "remove",
   "tag": "remove-driven-template", "after_ms": 400},

  {"do": "smiles", "smiles": "C1CCCCC1", "name": "Cyclohexane", "after_ms": 2500},
  {"do": "select", "molecule": "Cyclohexane", "after_ms": 2500},
  {"do": "template_library", "category": "Rings", "entry": "Pyridine", "press": "insert",
   "tag": "insert-on-cyclohexane", "after_ms": 1500,
   "expect": {"inserted": true, "smiles_contains": "."}},

  {"do": "select", "molecule": "Benzene", "after_ms": 1500},
  {"do": "template_library", "tag": "first-molecule-unchanged", "after_ms": 400,
   "expect": {"smiles_equals": "c1ccccc1"}},

  {"do": "quit"}
]
