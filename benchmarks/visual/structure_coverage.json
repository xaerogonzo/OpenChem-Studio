[
  {"do": "smiles", "smiles": "CCO", "name": "ethanol", "after_ms": 300},
  {"do": "smiles", "smiles": "CCCCCCCCCCCCOCCOCCOCCOCCOCCOCCO", "name": "C12E6 surfactant", "after_ms": 300},
  {"do": "smiles", "smiles": "CC(=O)[O-].[Na+]", "name": "sodium acetate", "after_ms": 300},
  {"do": "panel", "id": "Properties", "after_ms": 800},

  {"do": "dialog", "name": "SettingsDialog", "section": "calculators", "width": 820, "height": 560, "after_ms": 800},
  {"do": "control", "name": "showHiddenCalculators", "value": true, "after_ms": 500},
  {"do": "close_dialog", "after_ms": 500},
  {"do": "expand", "section": "identity", "expanded": false},
  {"do": "expand", "section": "surface"},
  {"do": "expand", "section": "energetic"},
  {"do": "expand", "section": "thermophysical"},
  {"do": "expand", "section": "solubility"},
  {"do": "expand", "section": "quantum_chemistry"},

  {"do": "select", "molecule": 1, "after_ms": 2500},
  {"do": "expect_coverage", "tag": "ethanol", "chips": {"griffin_hlb": "Not applicable", "oxygen_balance": "Can run", "joback_properties": "Can run", "hansen_solubility": "With limits"},
   "rows": {"orca.proton_affinity": "✓", "orca.bond_dissociation_enthalpy": "✓", "orca.nmr": ""},
   "tooltips": {"griffin_hlb": ["polyoxyethylene"], "hansen_solubility": ["OUTSIDE THE MODEL"], "orca.proton_affinity": ["inside what the method covers"]}},
  {"do": "properties_grab", "path": "artifacts/visual/structure_coverage_ethanol.png"},

  {"do": "select", "molecule": 2, "after_ms": 2500},
  {"do": "expect_coverage", "tag": "surfactant", "chips": {"griffin_hlb": "Can run", "oxygen_balance": "Can run", "joback_properties": "Can run", "hansen_solubility": "Can run"},
   "rows": {"orca.proton_affinity": "△", "orca.bond_dissociation_enthalpy": "△"},
   "tooltips": {"orca.proton_affinity": ["heavy atoms", "accepted, with a limit"]}},
  {"do": "properties_grab", "path": "artifacts/visual/structure_coverage_surfactant.png"},

  {"do": "select", "molecule": 3, "after_ms": 2500},
  {"do": "expect_coverage", "tag": "salt", "chips": {"griffin_hlb": "Not applicable", "oxygen_balance": "Can run", "joback_properties": "Not applicable", "hansen_solubility": "Not applicable"},
   "rows": {"orca.proton_affinity": "○"}, "tooltips": {"hansen_solubility": ["pure substance"]}},
  {"do": "properties_grab", "path": "artifacts/visual/structure_coverage_salt.png"},

  {"do": "select", "molecule": 1, "after_ms": 2500},
  {"do": "erase", "element": "O", "after_ms": 3500},
  {"do": "expect_coverage", "tag": "after-edit-ethane", "rows": {"orca.proton_affinity": "○"}, "tooltips": {"orca.proton_affinity": ["no protonation site"]}},
  {"do": "properties_grab", "path": "artifacts/visual/structure_coverage_after_edit.png"},

  {"do": "dialog", "name": "SettingsDialog", "section": "recalculation", "width": 820, "height": 520, "after_ms": 800},
  {"do": "shot", "path": "artifacts/visual/structure_coverage_setting.png", "widget": "dialog"},
  {"do": "control", "name": "structureCoverage", "value": false, "after_ms": 800},
  {"do": "close_dialog", "after_ms": 800},
  {"do": "expect_coverage", "tag": "switched-off", "silent": ["griffin_hlb", "oxygen_balance", "joback_properties", "hansen_solubility"],
   "rows": {"orca.proton_affinity": "", "orca.bond_dissociation_enthalpy": ""}},
  {"do": "properties_grab", "path": "artifacts/visual/structure_coverage_off.png"},

  {"do": "dialog", "name": "SettingsDialog", "section": "recalculation", "after_ms": 800},
  {"do": "control", "name": "structureCoverage", "value": true, "after_ms": 800},
  {"do": "close_dialog", "after_ms": 800},
  {"do": "expect_coverage", "tag": "switched-back-on", "chips": {"griffin_hlb": "Not applicable"}, "rows": {"orca.proton_affinity": "○"}},

  {"do": "dialog", "name": "SettingsDialog", "section": "calculators", "after_ms": 500},
  {"do": "control", "name": "resetCalculatorVisibility", "after_ms": 500},
  {"do": "close_dialog", "after_ms": 500},
  {"do": "expect_clean", "tag": "end"},
  {"do": "quit"}
]
