[
  {"do": "smiles", "smiles": "CCO", "name": "Ethanol", "after_ms": 3000},
  {"do": "select", "molecule": -1, "after_ms": 3000},
  {"do": "view_3d", "after_ms": 2000},
  {"do": "conformers", "count": 3, "after_ms": 20000},
  {"do": "conformer_report", "tag": "before",
   "expect": {"conformers": 2, "orca_conformers": 0, "badge_empty": true, "explorer_excludes": "[ORCA",
              "methods": ["rdkit+MMFF94/UFF", "rdkit+MMFF94/UFF"]}},

  {"do": "orca_optimize_button", "via": "button", "conformer": 1,
   "expect": {"chosen_slot": 2, "calc_type": "Geometry Optimization", "job_started": false, "status_contains": "press Run"}},
  {"do": "shot", "path": "benchmarks/visual/artifacts/orca_chosen_prepared.png", "after_ms": 1500},

  {"do": "qc_run", "method": "HF STO-3G"},
  {"do": "qc_wait", "timeout_ms": 600000},
  {"do": "conformer_report", "tag": "after-optimizing-the-second",
   "expect": {"conformers": 2, "orca_conformers": 1, "origin_slot": 2, "canonical_method": "orca_opt",
              "canonical_mapped": true, "viewer_index": 1, "viewer_on_canonical": true,
              "viewer_label_contains": "Conformer 2/2 - ORCA optimized (HF STO-3G)",
              "badge_contains": "ORCA-optimized geometry (HF STO-3G)", "explorer_contains": "[ORCA-optimized]",
              "methods": ["rdkit+MMFF94/UFF", "orca_opt"]}},
  {"do": "shot", "path": "benchmarks/visual/artifacts/orca_chosen_landed.png", "after_ms": 1500},

  {"do": "menu", "text": "Undo", "prefix": true, "after_ms": 3000},
  {"do": "conformer_report", "tag": "after-undo",
   "expect": {"orca_conformers": 0, "badge_empty": true, "explorer_excludes": "[ORCA",
              "methods": ["rdkit+MMFF94/UFF", "rdkit+MMFF94/UFF"]}},
  {"do": "menu", "text": "Redo", "prefix": true, "after_ms": 3000},
  {"do": "conformer_report", "tag": "after-redo",
   "expect": {"orca_conformers": 1, "origin_slot": 2, "badge_contains": "ORCA-optimized geometry (HF STO-3G)",
              "explorer_contains": "[ORCA-optimized]", "methods": ["rdkit+MMFF94/UFF", "orca_opt"]}},

  {"do": "orca_optimize_button", "via": "menu", "conformer": 0,
   "expect": {"chosen_slot": 1, "calc_type": "Geometry Optimization", "job_started": false, "status_contains": "press Run"}},
  {"do": "orca_optimize_button", "via": "menu", "conformer": 1,
   "expect": {"chosen_slot": 2, "job_started": false}},

  {"do": "expect_clean"},
  {"do": "quit"}
]
