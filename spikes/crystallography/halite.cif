data_halite
_chemical_name_mineral            'Halite'
_chemical_formula_sum             'Na Cl'
_chemical_name_structure_type     'NaCl (B1, rock salt)'

# a derived from the published cell VOLUME rather than quoted directly:
# V0 = 179.34 A^3 per cell at Z = 4, from Walker, Verma, Cranswick, Jones,
# Clark & Buhre, American Mineralogist 89 (2004) 204-210, Table 1
# (attributed there to Barrett & Wallace 1954).  a = V0^(1/3) = 5.6393 A.
_cell_length_a                    5.6393
_cell_length_b                    5.6393
_cell_length_c                    5.6393
_cell_angle_alpha                 90
_cell_angle_beta                  90
_cell_angle_gamma                 90
_cell_volume                      179.34
_cell_formula_units_Z             4

_symmetry_space_group_name_H-M    'F m -3 m'
_symmetry_Int_Tables_number       225

# The four face-centring translations ONLY, not the full 192 operations of
# Fm-3m. Both sites here sit on special positions whose site symmetry is
# the full point group, so the centring alone generates the correct cell
# contents: 4 Na + 4 Cl. A general position would need the whole list.
loop_
_symmetry_equiv_pos_as_xyz
  'x,y,z'
  'x,y+1/2,z+1/2'
  'x+1/2,y,z+1/2'
  'x+1/2,y+1/2,z'

loop_
_atom_site_label
_atom_site_type_symbol
_atom_site_fract_x
_atom_site_fract_y
_atom_site_fract_z
_atom_site_occupancy
  Na1  Na  0.0  0.0  0.0  1.0
  Cl1  Cl  0.5  0.5  0.5  1.0
