# Machine-specific config (if your project uses one)
*.local.json

# Claude Code local session settings
.claude/

# tokensave index (machine-specific binary database)
.tokensave/

# CodeGraph SQLite index — machine-specific binary database.
# IMPORTANT: do NOT blanket-ignore .codegraph/ — CodeGraph deliberately
# expects .codegraph/config.json to be TRACKED (per-project indexing
# configuration intended to be shared across machines). CodeGraph itself
# writes a .codegraph/.gitignore that handles binary-DB exclusion.
.codegraph/codegraph.db
.codegraph/codegraph.db-*

# Python cache
__pycache__/
*.pyc
*.pyo

# Frozen-build output: PyInstaller writes /dist and /build (root-anchored —
# do NOT match src/openchem/resources/ketcher/dist/, which is the vendored,
# committed Ketcher bundle the app loads at runtime). The *.build/ patterns
# are left over from the Nuitka scaffolding build.ps1 replaced; harmless.
*.onefile-build/
*.build/
/dist/
/build/

# Virtual environments
.venv/
venv/

# Node dependencies for tools/ketcher-host (the Ketcher build IS committed
# under src/openchem/resources/ketcher/dist/ — only node_modules is not)
node_modules/

# Logs
logs/

# OS noise
Thumbs.db
.DS_Store

# Manager-generated temp files (Draft PR pre-fetched context)
.pr_context.tmp.md
PR_DRAFT.md

# Added by TokenSave Manager

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eggs/
*.egg-info/

# Coverage reports
.coverage
.coverage.*
htmlcov/

# Secrets / environment overrides — never commit these
.env
.env.*
*.pem

# Node/npm noise for tools/ketcher-host (package-lock.json IS tracked
# intentionally, for reproducible Ketcher bundle rebuilds)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
