# Machine-specific config (if your project uses one)
*.local.json

# Claude Code local session settings
.claude/

# tokensave index (machine-specific binary database)
.tokensave/

# CodeGraph SQLite index — machine-specific binary database.
# IMPORTANT: do NOT blanket-ignore .codegraph/ — CodeGraph deliberately
# expects .codegraph/config.json to be TRACKED (per-project indexing
# configuration intended to be shared across machines). CodeGraph itself
# writes a .codegraph/.gitignore that handles binary-DB exclusion.
.codegraph/codegraph.db
.codegraph/codegraph.db-*

# Python cache
__pycache__/
*.pyc
*.pyo

# Frozen-build output: PyInstaller writes /dist and /build (root-anchored —
# do NOT match src/openchem/resources/ketcher/dist/, which is the vendored,
# committed Ketcher bundle the app loads at runtime). The *.build/ patterns
# are left over from the Nuitka scaffolding build.ps1 replaced; harmless.
*.onefile-build/
*.build/
/dist/
/build/

# Virtual environments
.venv/
venv/

# Node dependencies for tools/ketcher-host (the Ketcher build IS committed
# under src/openchem/resources/ketcher/dist/ — only node_modules is not)
node_modules/

# Logs
logs/

# OS noise
Thumbs.db
.DS_Store

# Manager-generated temp files (Draft PR pre-fetched context)
.pr_context.tmp.md
PR_DRAFT.md

# Added by TokenSave Manager

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eggs/
*.egg-info/

# Coverage reports
.coverage
.coverage.*
htmlcov/

# Secrets / environment overrides — never commit these
.env
.env.*
*.pem

# Node/npm noise for tools/ketcher-host (package-lock.json IS tracked
# intentionally, for reproducible Ketcher bundle rebuilds)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
_build_stamp.py


# tokensave MCP binding (TokenSave Manager) — machine-local by choice
.mcp.json

# Self-hosted benchmark output. `benchmarks-selfhosted.yml` writes every
# benchmark here and uploads the directory as the run's artifact, so it is
# build output rather than anything to keep -- and it was never ignored,
# which left an untracked directory in the tree after any local run of the
# IR, ESP or docking benchmarks. Same shape as the naming gate leaving an
# untracked predictions file, which this project already records.
bench-out/

# The PDF library manifest from `tools/index_pdf_library.py`. MACHINE-SPECIFIC
# by construction -- it records sha256s and confidences for one person's
# `Sci Downloads` folder, which is not in this repo and is not the same folder
# on any two machines. The TOOL is tracked; its output is not, for the same
# reason `bench-out/` above is not: it is a measurement of a local
# environment rather than anything a reader of this repository can use.
pdf-library.json

# Driven visual checks write shots here; the scripts are tracked, the
# output is not. See benchmarks/visual/README.md.
artifacts/

# `pyscope` maintains this index in the working tree and rewrites it as it
# runs, so a tracked copy conflicts on every branch switch. It was committed
# by accident in 0da570c.
.pyscope/
benchmarks/free_energy/cache/
benchmarks/free_energy/results/
